#: /Users/m/w/rdm-14/nrp/nma/riv/resolvers/handle.py:171
msgid "Missing creators."
msgstr "Chybí autoři."

#: /Users/m/w/rdm-14/nrp/nma/riv/resolvers/datacite.py:224
msgid ""
"The identifier looks like a DOI, but it was not found in the DataCite "
"registry."
msgstr "Identifikátor vypadá jako DOI, ale nebyl nalezen v registru DataCite."

#: /Users/m/w/rdm-14/nrp/nma/riv/resolvers/handle.py:121
msgid ""
"The identifier looks like a Handle, but it was not found in the Handle "
"registry."
msgstr "Identifikátor vypadá jako Handle, ale nebyl nalezen v registru Handle."

#: /Users/m/w/rdm-14/nrp/nma/riv/resolvers/handle.py:136
msgid ""
"Unexpected error while resolving the Handle. Please fill the metadata "
"manually."
msgstr ""
"Neočekávaná chyba při načítání metadat z cílového repozitáře. Prosím, "
"vyplňte metadata ručně."

#: /Users/m/w/rdm-14/nrp/nma/riv/resolvers/handle.py:209
msgid "Publication date missing."
msgstr "Chybí datum publikace."

#: /Users/miroslavbauer/Code/github.com/EOSC-CZ/nma/riv/resolvers/utils.py:35
msgid "Unexpected error while parsing the metadata."
msgstr "Neočekávaná chyba při načítání metadat."

