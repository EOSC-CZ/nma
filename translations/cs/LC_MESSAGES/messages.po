#: /Users/dusanstojanovic/Projects/nma/invenio.cfg:19
msgid "Harvesting metadata of scientific repositories in the Czech Republic"
msgstr "Sbírá metadata vědeckých repozitářů v České republice"

#: /Users/dusanstojanovic/Projects/nma/invenio.cfg:22
msgid ""
"The National Metadata Directory (NMD) aggregates metadata from Czech "
"research repositories and enables unified searching across datasets with "
"links to original records."
msgstr ""
"Národní metadatový adresář (NMA) agreguje metadata z českých výzkumných "
"repozitářů a umožňuje jednotné vyhledávání napříč datovými sadami s "
"odkazy na původní záznamy."

#: /Users/dusanstojanovic/Projects/nma/invenio.cfg:25
msgid ""
"national metadata directory, NMD, dataset metadata, research data search,"
" data repositories, metadata aggregator, Czech academic data, research "
"datasets, data discovery platform, eosc-cz, eosc cz, european open "
"science cloud"
msgstr ""
"národní metadatový adresář, NMA, metadata datových sad, vyhledávání "
"výzkumných dat, datové repozitáře, agregátor metadat, česká akademická "
"data, výzkumné datové sady, platforma pro objevování dat, eosc-cz, eosc "
"cz, european open science cloud"

