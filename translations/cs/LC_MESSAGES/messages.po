#: /Users/m/w/rdm-14/nrp/nma/riv/resolvers/crossref.py:87
msgid ""
"The identifier looks like a DOI, but it was not found in the CrossRef "
"registry."
msgstr "Identifikátor vypadá jako DOI, ale nebyl nalezen v registru CrossRef."

#: /Users/m/w/rdm-14/nrp/nma/riv/resolvers/crossref.py:102
#: /Users/m/w/rdm-14/nrp/nma/riv/resolvers/datacite.py:239
msgid ""
"Unexpected error while resolving the DOI. Please fill the metadata "
"manually."
msgstr ""
"Neočekávaná chyba při načítání metadat z DOI. Prosím, vyplňte metadata "
"ručně."

#: /Users/miroslavbauer/Code/github.com/EOSC-CZ/nma/riv/resolvers/crossref.py:141
#: /Users/miroslavbauer/Code/github.com/EOSC-CZ/nma/riv/resolvers/datacite.py:529
msgid ""
"The title is too short. A minimum of 3 characters is required to meet "
"repository requirements."
msgstr ""
"Název je příliš krátký. Pro splnění požadavků repozitáře jsou vyžadovány "
"minimálně 3 znaky."

#: /Users/m/w/rdm-14/nrp/nma/riv/resolvers/crossref.py:151
