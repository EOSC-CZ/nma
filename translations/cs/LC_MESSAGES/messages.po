msgid "Metadata Record"
msgstr "Metadatový záznam"

#: /Users/m/w/rdm-14/nrp/nma/ui/datasets/templates/semantic-ui/datasets/DepositEdit.jinja:20
msgid "Modify record metadata."
msgstr "Upravit metadata záznamu."

