msgstr "Přístup"

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/access_status.html:10
msgid ""
"This record is publicly accessible. Anyone can view and download the "
"content."
msgstr "Tento záznam je veřejně přístupný. Kdokoli může zobrazit a stáhnout obsah."

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/access_status.html:10
msgid ""
"This record is not publicly accessible. Viewing or downloading the "
"content requires meeting specific access conditions."
msgstr ""
"Tento záznam není veřejně přístupný. Zobrazení nebo stažení obsahu "
"vyžaduje splnění specifických přístupových podmínek."

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/access_status.html:12
msgid "Open"
msgstr "Otevřený"

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/access_status.html:12
msgid "Restricted"
msgstr "Omezený"

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/main.html:74
msgid "Open record management menu"
msgstr "Otevřít menu správy záznamu"

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/main.html:76
msgid "Manage record"
msgstr "Spravovat záznam"

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/main.html:122
msgid "Original source check status"
msgstr "Stav kontroly původního zdroje"

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/main.html:141
msgid ""
"Original source confirmed. The dataset is still available at its "
"authoritative repository."
msgstr ""
"Původní zdroj potvrzen. Datová sada je stále dostupná ve svém "
"autoritativním repozitáři."

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/main.html:143
msgid ""
"Original source not found. The dataset is no longer available at the "
"specified location."
msgstr ""
"Původní zdroj nebyl nalezen. Datová sada již není na uvedeném místě dostupná."

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/main.html:145
msgid "Error checking original source. Unable to verify dataset availability."
msgstr "Chyba při kontrole původního zdroje. Nelze ověřit dostupnost datové sady."

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/main.html:147
msgid "Original source not accessible. The dataset location cannot be reached."
msgstr "Původní zdroj není přístupný. K umístění datové sady se nelze připojit."

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/main.html:149
msgid "Warning: Issue detected with original source."
msgstr "Varování: Zjištěn problém s původním zdrojem."

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/main.html:153
msgid "Last checked: "
msgstr "Naposledy zkontrolováno: "

#: /Users/dusanstojanovic/Projects/nma/ui/datasets/templates/semantic-ui/datasets/record_detail/permalink.html:13
