#: /Users/dusanstojanovic/Projects/nma/common/workflows/default.py:360
msgid "state:draft"
msgstr "koncept"

#: /Users/dusanstojanovic/Projects/nma/common/workflows/default.py:361
msgid "state:published"
msgstr "publikováno"

#: /Users/dusanstojanovic/Projects/nma/common/workflows/default.py:362
msgid "state:submitted"
msgstr "odesláno"

#: /Users/dusanstojanovic/Projects/nma/common/workflows/default.py:363
msgid "state:retracting"
msgstr "staženo"

#: /Users/dusanstojanovic/Projects/nma/common/workflows/default.py:364
