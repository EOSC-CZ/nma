.ui.label {
  &.truncated {
    width: 100%;
    overflow-x: scroll;
  }
  &.source-check {
    width: 100%;
  }
  &.active-filter-label {
    font-weight: normal;
    color: black;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }
  &.active-filters-count-label {
    left: 110%;
    background-color: @primaryColor;
    color: @white;
  }
  // NMA never stores files, so every record is "metadata-only" - the label carries no information
  &.access-status.metadata-only {
    display: none;
  }
}

.ui.labels {
  &.active-filters-group > .label {
    color: black;
    margin-right: 0.5rem;
    padding: 0.5rem 1rem;
  }
}

.ui.form {
  .field {
    label.helptext {
      margin-top: 0;
    }
  }
}
