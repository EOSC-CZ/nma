// they have hardcoded layout of the component and as we use font-size of 16,
// it just does not fit. This is a bit hacky, but otherwise, we would have to override
// entire react component
.ui.segment {
  &.rdm-sidebar {
    dd {
      word-break: break-word;
      overflow-wrap: break-word;
    }
  }
  &.exports.rdm-sidebar {
    font-size: 14px !important;
    .ui.button {
      font-size: 14px !important;
    }
  }

  // Persistent identifier segments
  &.persistent-identifier,
  &.riv-identifier {
    .identifier-link {
      word-break: break-word;
      font-size: @h3;
      font-weight: bold;
      .ui.button {
        font-size: @h3;
      }
    }
    background-color: lighten(@lightGrey, 5%);
    .segment-header {
      padding: 0.75em 1em;
      margin: -1em -1em 1em -1em;
      font-weight: bold;
      border-radius: 0.28571429rem 0.28571429rem 0 0;

      &.green {
        background-color: @green;
        color: white;
      }

      &.red {
        background-color: @pink;
        color: white;
      }
    }
  }

  &.persistent-identifier {
    position: relative;
    padding-left: 3rem;

    &::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 2rem;
      background-color: @green;
      border-radius: 0.28571429rem 0 0 0.28571429rem;
    }

    .segment-header {
      margin-left: -3rem;
      padding-left: 3rem;
    }
  }
}
