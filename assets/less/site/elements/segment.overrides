// they have hardcoded layout of the component and as we use font-size of 16,
// it just does not fit. This is a bit hacky, but otherwise, we would have to override
// entire react component
.ui.segment {
  &.rdm-sidebar {
    dd {
      word-break: break-word;
      overflow-wrap: break-word;
    }
  }
  &.exports.rdm-sidebar {
    font-size: 14px !important;
    .ui.button {
      font-size: 14px !important;
    }
  }

  // RDM record_header_info row rendered inside the title segment: drop grid/row padding and the trailing hidden divider
  &.record-title {
    #record-info > .ui.grid {
      margin-top: 0;
      margin-bottom: 0;
    }
    #record-info > .ui.grid,
    #record-info > .ui.grid > .row {
      padding: 0;
    }
    #record-info + .ui.divider.hidden {
      margin: 0.5rem 0;
    }
  }

  // Persistent identifier segments
  &.persistent-identifier,
  &.riv-identifier {
    .identifier-link {
      word-break: break-word;
      font-size: @h3;
      font-weight: bold;
      .ui.button {
        font-size: @h3;
      }
    }
    background-color: lighten(@lightGrey, 5%);
    .segment-header {
      padding: 0.75em 1em;
      margin: -1em -1em 1em -1em;
      font-weight: bold;
      border-radius: 0.28571429rem 0.28571429rem 0 0;

      &.green {
        background-color: @green;
        color: white;
      }

      &.red {
        background-color: @pink;
        color: white;
      }
    }
  }
}
