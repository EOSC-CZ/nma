/***********************************************
    Invenio NRP Site Styling Variables
***********************************************/

/*-------------------
    Brand Colors
--------------------*/

@livelyGreen: #008691;
@pink: #9F0D54;
@primaryColor: @pink;
@secondaryColor: @livelyGreen;
@darkGrey: #707075;
@lightGrey: #e4e4e3;
@black: #040305;
@white: #ffffff;

@lightPrimaryColor: lighten(@primaryColor, 50);
@lightSecondaryColor: lighten(@primaryColor, 50);
@primaryDarkenColor: @darkGrey;

@selectionBackground: @lightGrey;
@celledBorderColor: @primaryColor;

// for backwards compatibility
@brandColor: @primaryColor;
@brand-primary:@primaryColor;

/*-------------------
      Site Colors
--------------------*/

@green: @livelyGreen;
@red: darken(@pink, 20);
@signupColor: @green;

@accessRightOpen: @green;
@accessRightRestricted: @red;
@accessRightEmbargoed: @yellow;
@accessRightMetadataOnly: @teal;

@restricted-components-background-color: #feeaea;
@restricted-components-border-color: #e0b4b4;
@embargoed-components-background-color: #fbf8ee;
@embargoed-components-border-color: #c9ba9b;

@footerLightColor: #EEE5E7;
@footerDarkColor: darken(@footerLightColor, 5%);
@subFooterColor: @footerDarkColor;
@footerTextLightColor: @textColor;
@footerTextDarkColor: darken(@textColor, 5%);

@navbar_background_image: linear-gradient(
  130deg,
  hsl(185deg 100% 93%) 0%,
  hsl(185deg 100% 94%) 4%,
  hsl(185deg 100% 96%) 10%,
  hsl(185deg 100% 97%) 17%,
  hsl(185deg 100% 98%) 27%,
  hsl(185deg 100% 99%) 39%,
  hsl(0deg 0% 100%) 52%,
  hsl(185deg 100% 98%) 64%,
  hsl(185deg 100% 95%) 75%,
  hsl(185deg 100% 92%) 84%,
  hsl(185deg 100% 90%) 91%,
  hsl(185deg 100% 87%) 96%,
  hsl(185deg 100% 84%) 100%
);
@navbar_background_color: @white;

@coverPageBackgroundColor: @white;

@textColor: #262729;
@errorTextColor: #9f3a38;
@focusedFormBorderColor: @primaryColor;
@focusedFormMutedBorderColor: @primaryColor;

@highlightHeaderColor: @lightGrey;
@highlightBackgroundColor: @highlightHeaderColor;
@highlightBackgroundColorHover:  darken(saturate(@highlightHeaderColor, 20), 15, relative);
@highlightLandingPageBackgroundColor: @white;
@selectedColor: #ededed;

@navbarBackgroundImage: @navbar_background_image;
@navbarBackgroundColor: @navbar_background_color;
@versionActiveColor: #d9edf7;

@mutedAccordionHeaderColor: #f5f5f5;
@defaultBrandColor: #434C5E;

@heroBackgroundColor: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%2331b0d4' fill-opacity='0.08' fill-rule='evenodd'/%3E%3C/svg%3E");

@featuredListBackgroundColor: transparent;

@searchButtonColor: @pink;

/*-------------------
      Links
--------------------*/

@linkColor: #005b9e;
@linkUnderline: none;
@linkHoverColor: darken(saturate(@linkColor, 20), 15, relative);
@linkHoverUnderline: underline;

/*-------------------
    Breakpoints
--------------------*/
@mobileBreakpoint            : 320px;
@tabletBreakpoint            : 768px;
@computerBreakpoint          : 1300px;
@largeMonitorBreakpoint      : 1680px;
@widescreenMonitorBreakpoint : 1920px;

/*-------------------
      Fonts
--------------------*/

@importGoogleFonts: true;
@googleProtocol: 'https://';
@googleFontRequest: "IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&display=swap";
@emSize: 16px;
@fontSize: 16px;
@fontSizeBase: 16px;
@font-size-small: 0.9rem;
@font-size-tiny: 0.8rem;
@font-size-massive: 2.5rem;
@fontName: 'IBM Plex Sans', system-ui, sans-serif;
@fontFamily: 'IBM Plex Sans', system-ui, sans-serif;
@pageFont: 'IBM Plex Sans', system-ui, sans-serif;
@headerFont: 'IBM Plex Sans', system-ui, sans-serif;

@h1: 2.5rem;
@h2: 2rem;
@h3: 1.5rem;
@h4: 1.25rem;
@h5: 1rem;

/*-------------------
     Em Sizes
--------------------*/

@75px : unit( (75 / @emSize), rem);
@relative75px : unit( (75 / @emSize), em);


/*-------------------
  negative spacing
--------------------*/
@coverPageDefaultMargin: 0;
@groupCardMargin: 1rem;

/* borders */

@dashedBorder: 2px dashed @borderColor;
@defaultBorder: 1px solid @solidBorderColor;
@borderRadius: 0.5rem;
@inputBorderRadius: 0.5rem;

/*------------------
  checkboxes
------------------*/

@checkboxSize: @relative17px;

/*------------------
  tables
------------------*/

@cellVerticalPadding: @relativeMini;
@cellHorizontalPadding: @relativeMini;


/*------------------
  Images
------------------*/

@userDashboardAvatarSize: 40px;
@communityItemLogoWidth: 115px;


/*------------------
  Separators
------------------*/
@listSeparator: ";";
@listCommaSeparator: ",";
